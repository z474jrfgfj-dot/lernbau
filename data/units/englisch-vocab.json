      "cards": [
        {"id": "englisch-vocab-m1-c001", "type": "vocab", "en": "construction site", "de": "die Baustelle", "example": "Yesterday I wasn't on a construction site.", "exampleDe": "Gestern war ich nicht auf einer Baustelle.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c002", "type": "vocab", "en": "location", "de": "die Lage", "example": "The construction site was in Würzburg.", "exampleDe": "Die Baustelle war in Würzburg.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c003", "type": "vocab", "en": "building material", "de": "das Baumaterial", "example": "The construction site has a lot of building material.", "exampleDe": "Auf der Baustelle gibt es viel Baumaterial.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c004", "type": "vocab", "en": "wood", "de": "das Holz", "example": "Most of the building material was wood.", "exampleDe": "Das meiste Baumaterial war Holz.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c005", "type": "vocab", "en": "brick", "de": "der Ziegelstein", "example": "We need more bricks on the construction site.", "exampleDe": "Wir brauchen mehr Ziegelsteine auf der Baustelle.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c006", "type": "vocab", "en": "equipment", "de": "das Gerät / die Geräte", "example": "We had a lot of equipment.", "exampleDe": "Wir hatten viele Geräte.", "note": "Dein Satz vom Blatt, sprachlich korrigiert. „equipment“ hat keinen Plural (nicht: equipments)."},
        {"id": "englisch-vocab-m1-c007", "type": "vocab", "en": "crane", "de": "der Kran", "example": "The construction site has a crane.", "exampleDe": "Die Baustelle hat einen Kran.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c008", "type": "vocab", "en": "excavator", "de": "der Bagger", "example": "The construction site has an excavator.", "exampleDe": "Die Baustelle hat einen Bagger.", "note": "Dein Satz vom Blatt, sprachlich korrigiert. Vor Vokal: an excavator."},
        {"id": "englisch-vocab-m1-c009", "type": "vocab", "en": "soil", "de": "der Erdboden", "example": "The excavator is digging soil.", "exampleDe": "Der Bagger gräbt Erdboden.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c010", "type": "vocab", "en": "construction worker", "de": "der Bauarbeiter / die Bauarbeiterin", "example": "A lot of construction workers are working on the construction site.", "exampleDe": "Auf der Baustelle arbeiten viele Bauarbeiter.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
        {"id": "englisch-vocab-m1-c011", "type": "vocab", "en": "dumper truck", "de": "der Muldenkipper", "example": "The excavator loads the dumper truck.", "exampleDe": "Der Bagger belädt den Muldenkipper.", "note": "Dein Satz vom Blatt, sprachlich korrigiert."},
