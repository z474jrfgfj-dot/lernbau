        {"id": "mathe-4-brueche-q024", "type": "mc", "question": "Vereinfache so weit wie möglich: **(2a² − 4ab + 2b²) / (2a² − 2b²)**", "options": ["(a + b) / (a − b)", "a − b", "(a − b) / (a + b)", "(a − b)² / (a + b)"], "answer": 2, "explanation": "**(a − b) / (a + b)** (Faktoren bilden, dann kürzen)"},
